# Backend Environment Variables — Example
# Copy this file to .env and fill in all required values.
# NEVER commit the actual .env file to version control.

# ── Database ────────────────────────────────────────────────────────────────
# SQLite (local development):
DATABASE_URL=sqlite+aiosqlite:///./ipo_copilot.db
# PostgreSQL (production/Docker):
# DATABASE_URL=postgresql+asyncpg://ipo:<PASSWORD>@postgres:5432/ipo_copilot

# ── Security ────────────────────────────────────────────────────────────────
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_WITH_secrets_token_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── AI Providers ────────────────────────────────────────────────────────────
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# Groq API Key — get from https://console.groq.com/
GROQ_API_KEY=MISSING_REQUIRED_KEY

# Google Gemini API Key — get from https://aistudio.google.com/
GOOGLE_API_KEY=MISSING_REQUIRED_KEY

# ── Embeddings ──────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Storage ─────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── PostgreSQL (Docker only) ────────────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
